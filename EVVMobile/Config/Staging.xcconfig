// EVVMobile/Config/Staging.xcconfig — build settings for the STAGING app
// (target EVVMobileStaging, scheme "EVVMobile Staging", bundle net.fbhi.evvmobile.staging).
//
// Installs SIDE BY SIDE with the live app (different bundle id => its own sandbox,
// keychain and offline queue — nothing is shared). Talks to the NorthStar STAGING
// stack (branch `main` of focus-nexus, de-identified data, outbound integrations
// stubbed). Built by Xcode Cloud from branch `main` of this repo.
//
// NOTE: in xcconfig files "//" starts a comment, so URLs are written with the
// $() trick: "https:/$()/host" expands to "https://host".

EVV_ENVIRONMENT_NAME = staging
EVV_DISPLAY_NAME = EVV Staging
EVV_API_BASE_URL = https:/$()/d2vx4uq6k3g4bo.cloudfront.net/api

// Google iOS OAuth client for the STAGING bundle — NOT CREATED YET.
// TODO(Nick): create an "iOS" OAuth client in GCP project 965407510424 with bundle id
// net.fbhi.evvmobile.staging, then paste its client id below and its reversed form
// on the next line, e.g.
//   EVV_GOOGLE_IOS_CLIENT_ID = 965407510424-abc123.apps.googleusercontent.com
//   EVV_GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.965407510424-abc123
// and set GOOGLE_IOS_CLIENT_ID to the same client id in the staging server secret
// (AWS Secrets Manager evv-staging/app-env) — the server checks the token audience.
// While the placeholder client id is in place, GoogleAuthConfig.isConfigured is false:
// the Google button reports "not configured" and email/password login is the way in.
EVV_GOOGLE_IOS_CLIENT_ID = REPLACE_ME.apps.googleusercontent.com

// 🚨 2026-09-28 — CFBundleURLSchemes must be a WELL-FORMED scheme or App Store Connect
// rejects the upload: staging build 5 was rejected with ITMS-90158 because the
// placeholder "com.googleusercontent.apps.REPLACE_ME" contains an underscore (URL
// schemes allow only letters, digits, "+", "-", "."). Info.plist is SHARED by both
// targets (its CFBundleURLSchemes entry is $(EVV_GOOGLE_REVERSED_CLIENT_ID)), so the
// staging target cannot simply drop the entry without a second plist — and a second
// plist would also fall outside ci_scripts/ci_post_clone.sh's CFBundleVersion stamping
// (the 2026-08-27 build-number-collision failure). Instead staging registers a valid,
// app-owned scheme that is never used at runtime: nothing links to it, and Google
// sign-in is inert here anyway (isConfigured == false, no redirect is ever made).
// When the real staging iOS OAuth client exists, replace BOTH lines with the reversed
// client id, exactly like Live.xcconfig, and this note goes away.
EVV_GOOGLE_REVERSED_CLIENT_ID = net.fbhi.evvmobile.staging

// App Review demo login (build 112, Todoist 6hfjGWqR5JMJPwrq — unlisted App Store
// readiness). Entering EXACTLY these credentials on the email/password form opens the
// built-in demo mode (AppState.loginAsDemo): sample data only, no network call, nothing
// syncs, orange "DEMO MODE — Not real data" banner. It never reaches the server, so the
// password is not a secret — it unlocks fake data and nothing else. Give both to App
// Review in the "Sign-in required" box. Leave either blank to disable the demo login.
EVV_REVIEW_DEMO_EMAIL = appreview@fbhi.net
EVV_REVIEW_DEMO_PASSWORD = NorthStarReview-2026
